function CH1D_bifurcation()
    clc; clear; close all;

    %% Parameters
    t0 = 0.0;
    T  = 100.0;
    dt = 0.1;

    xscale = 10;

    Lx = xscale*pi;

    Nx = 2^11;

    dx = 2*Lx/Nx;

    plot_dt = 1; 
    plot_every = round(plot_dt / dt); % make multiple of dt

    mu = 0.2;

    %% Initial condition
    % spatial grid (needed for patterned base state)
    x = (-Nx/2:Nx/2-1)*dx;

    % Zero mean white noise
    u0 = (rand(1, Nx) - 0.5);

    u_hat = fft(u0);

    %% discretization
    % time discretization
    t = t0:dt:T;
    num_time_steps = length(t);

    %% Fourier wavenumbers
    kx = pi*[0:Nx/2-1 -Nx/2:-1]/Lx;
    Laplacian_hat = -kx.^2;

    % Linear operator:
   
    %
    % u_t = - Delta (Delta u + mu*u - u^3)
    %

    L_operator = -(Laplacian_hat.^2) + mu * Laplacian_hat;
    %% 2/3 dealiasing mask
    kx_max = max(abs(kx));
    dealias_mask = abs(kx) <= (2/3)*kx_max;

    %% ETDRK4 setup
    E  = exp(dt*L_operator);
    E2 = exp(dt*L_operator/2);
    M = 16; % no. of points for complex means
    r = exp(1i*pi*((1:M)-0.5)/M); % roots of unity
    Lvec = L_operator(:);
    LR = dt*Lvec(:,ones(M,1)) + r(ones(numel(L_operator),1),:);

    Q  = dt*real(mean((exp(LR/2)-1)./LR,2)).';
    f1 = dt*real(mean((-4-LR + exp(LR).*(4-3*LR+LR.^2))./LR.^3 ,2)).';
    f2 = dt*real(mean((2+LR + exp(LR).*(-2+LR))./LR.^3 ,2)).';
    f3 = dt*real(mean((-4-3*LR-LR.^2 + exp(LR).*(4-LR))./LR.^3 ,2)).';

    clear LR Lvec

    %% Plot setup
    fig = figure('Position',[100 100 1400 450]);

    %% Pre-allocate tracking metrics
    mean_hist = zeros(1, num_time_steps);
    u = real(ifft(u_hat));
    mean_hist(1) = trapz(u) * dx * 0.5 / Lx;

    %% Subplot 1: Solution
    ax1 = subplot(1,3,1);
    hLine1 = plot(ax1, x, u, 'LineWidth', 1.5);

    ylim(ax1, [-1.2 1.2]); 
    xlabel(ax1, 'x'); 
    ylabel(ax1, 'u');

    hTitle1 = title(ax1, sprintf('t = %.3f', t0));
    grid(ax1, 'on');

    %% Subplot 2: Mean value
    ax2 = subplot(1,3,2);
    hLine2 = plot(ax2, t(1), mean_hist(1), 'LineWidth', 2);

    xlabel(ax2, 't'); 
    ylabel(ax2, 'Mean Value');

    grid(ax2, 'on');

    %% Subplot 3: Fourier Spectrum
    ax3 = subplot(1,3,3);
    hLine3 = plot(ax3, kx, abs(u_hat), 'LineWidth', 1.5);

    xlabel(ax3, 'Wavenumber (k)'); 
    ylabel(ax3, '$|\hat{u}|$', 'Interpreter', 'latex')

    grid(ax3, 'on');

    drawnow limitrate

    %% GIF setup
    save_gif = true;
    gif_filename = sprintf('CH_ETDRK4_mu=%.2f.gif', mu);
    if save_gif && exist(gif_filename, 'file') % delete file if it exists
        delete(gif_filename); 
    end

    %% Time loop

    for n = 2:num_time_steps
        % ETDRK4
        u3_hat = fft(u.^3);
        Nu_hat = dealias_mask .* Laplacian_hat .* u3_hat;
        
        a_hat = E2.*u_hat + Q.*Nu_hat;
        a = real(ifft(a_hat));
        Na_hat = dealias_mask .* Laplacian_hat .* fft(a.^3);
        
        b_hat = E2.*u_hat + Q.*Na_hat;
        b = real(ifft(b_hat));
        Nb_hat = dealias_mask .* Laplacian_hat .* fft(b.^3);
        
        c_hat = E2.*a_hat + Q.*(2*Nb_hat - Nu_hat);
        c = real(ifft(c_hat));
        Nc_hat = dealias_mask .* Laplacian_hat .* fft(c.^3);
        
        u_hat = E.*u_hat + f1.*Nu_hat + 2*f2.*(Na_hat + Nb_hat) + f3.*Nc_hat;
        u = real(ifft(u_hat));

        mean_hist(n) = trapz(u) * dx * 0.5 / Lx;


        % Update figures
        if mod(n - 1, plot_every) == 0
            hLine1.YData = u;
            hTitle1.String = sprintf('t = %.2f', t(n));
            
            hLine2.XData = t(1:n);
            hLine2.YData = mean_hist(1:n);
            axis(ax2, 'tight');
            
            hLine3.YData = abs(u_hat);
            
            drawnow limitrate % High performance render refresh
            
            if save_gif
                % Modern, clean single-line GIF output
                exportgraphics(fig, gif_filename, 'Append', true);
            end
        end
    end

    disp(['GIF saved to: ', gif_filename])

end


%% Seismic colormap
function cmap = seismic_colormap()

    n = 256;

    r = [(0:n/2-1)/(n/2), ones(1,n/2)];
    g = [(0:n/2-1)/(n/2), (n/2-1:-1:0)/(n/2)];
    b = [ones(1,n/2), (n/2-1:-1:0)/(n/2)];

    cmap = [r(:),g(:),b(:)];

end