
        %% Diagnostics

        u_phys = real(ifft(u_hat));

        t_hist(end+1) = t(n+1);

        l2_hist(end+1) = ...
            l2_norm_periodic_1D(u_hat,Lx);

        comput_density(end+1) = ...
            domainwall_density_computed(u_phys,Lx);

        theory_density(end+1) = ...
            domainwall_density_theory( ...
                t(n+1),Laplacian_k,u_hat);



function CH1D_ETDRK4()
    clc; clear; close all;

    %% Parameters
    t0 = 0.0;
    T  = 1500.0;
    dt = 0.1;

    xscale = 10;

    Lx = xscale*pi;

    Nx = 2^11;

    dx = 2*Lx/Nx;

    plot_dt = 10.0; 
    plot_every = round(plot_dt / dt); % make multiple of dt

    epsilon = 0.01;

    %% functions
    function mu_val = mu(t)
        mu_val = t*epsilon;
    end

    function P = power_spec(t, Laplacian_k, u_hat)
        ksq = -Laplacian_k;
        P = abs(u_hat).^2 .* exp(t^2*ksq*epsilon - 2*t*ksq.^2);
    end

    function n = domainwall_density_theory(t, Laplacian_k, u_hat)
        P = power_spec(t, Laplacian_k, u_hat);
        ksq = -Laplacian_k;

        num = sum(ksq.*P,'all');
        den = sum(P,'all');

        n = (1/pi)*sqrt(num/den);
    end

    function density = domainwall_density_computed(u, domain_length)
        walls = sum(u .* circshift(u,-1) < 0);
        density = walls / domain_length;
    end

    %% Initial condition
    sigma = 0.01;
    u0 = sigma*randn(1,Nx);

    u_hat = fft(u0);
    u = u0;

    %% discretization
    % time discretization
    t = t0:dt:T;
    num_time_steps = length(t);

    % spatial grid
    x = (-Nx/2:Nx/2-1)*dx;

    %% Fourier wavenumbers
    kx = pi*[0:Nx/2-1 -Nx/2:-1]/Lx;
    Laplacian_hat = -kx.^2;

    % Linear operator:
   
    %
    % u_t = - Delta (Delta u + mu*u - u^3)
    %

    L_operator = -(Laplacian_hat.^2);
    %% 2/3 dealiasing mask
    kx_max = max(abs(kx));
    dealias_mask = abs(kx) <= (2/3)*kx_max;

    %% ETDRK4 setup
    E  = exp(dt*L_operator);
    E2 = exp(dt*L_operator/2);
    M = 32; % no. of points for complex means
    r = exp(1i*pi*((1:M)-0.5)/M); % roots of unity
    Lvec = L_operator(:);
    LR = dt*Lvec(:,ones(M,1)) + r(ones(numel(L_operator),1),:);

    Q  = dt*real(mean((exp(LR/2)-1)./LR,2)).';
    f1 = dt*real(mean((-4-LR + exp(LR).*(4-3*LR+LR.^2))./LR.^3 ,2)).';
    f2 = dt*real(mean((2+LR + exp(LR).*(-2+LR))./LR.^3 ,2)).';
    f3 = dt*real(mean((-4-3*LR-LR.^2 + exp(LR).*(4-LR))./LR.^3 ,2)).';

    clear LR Lvec

    %% Plot setup
    fig = figure('Position',[100 100 1400 450]);

    %% Pre-allocate tracking metrics
    mean_hist = zeros(1, num_time_steps);
    mean_hist(1) = trapz(u) * dx * 0.5 / Lx;
    
    computed_density = zeros(1, num_time_steps);
    computed_density(1) = domainwall_density_computed(u, 2*Lx);

    theory_density = zeros(1, num_time_steps);
    theory_density(1) = domainwall_density_theory(t0,Laplacian_hat, u_hat);
    


    %% Subplot 1: Solution
    ax1 = subplot(1,3,1);
    hLine1 = plot(ax1, x, u, 'LineWidth', 1.5);

    ylim(ax1, [-1.2 1.2]); 
    xlabel(ax1, 'x'); 
    ylabel(ax1, 'u');

    hTitle1 = title(ax1, sprintf('t = %.3f, mu = %.3f', t0, mu(t(1))));
    grid(ax1, 'on');

    %% Subplot 2: Mean value
    ax2 = subplot(1,3,2);
    hLine2 = plot(ax2, t(1), mean_hist(1), 'LineWidth', 2);

    xlabel(ax2, 't'); 
    ylabel(ax2, '||u||_{L^2}');

    grid(ax2, 'on');

    %% Subplot 3: Fourier Spectrum
    ax3 = subplot(1,3,3);

    theory_density_line = plot(ax3, t(1), theory_density, ...
        'LineWidth',2,'DisplayName','theoretical');

    hold(ax3, 'on');

    computed_density_line = plot(ax3, t(1), computed_density, ...
        'LineWidth',2,'DisplayName','computed');

    grid(ax3, 'on');
    legend(ax3, 'show');

    drawnow limitrate

    %% GIF setup
    save_gif = true;
    gif_filename = sprintf('cahn_hilliard_1D_mu(1)=%.2f.gif', mu);
    if save_gif && exist(gif_filename, 'file') % delete file if it exists
        delete(gif_filename); 
    end

    %% Time loop

    for n = 2:num_time_steps
        mu = mu(t(n));
        % Stage 1
        u3_nonlinear = u.^3 - mu*u;
        Nu_hat = dealias_mask .* Laplacian_hat .* fft(u3_nonlinear);
        
        % Stage 2
        a_hat = E2.*u_hat + Q.*Nu_hat;
        a = real(ifft(a_hat));
        Na_hat = dealias_mask .* Laplacian_hat .* fft(a.^3 - mu*a);
        
        % Stage 3
        b_hat = E2.*u_hat + Q.*Na_hat;
        b = real(ifft(b_hat));
        Nb_hat = dealias_mask .* Laplacian_hat .* fft(b.^3 - mu*b);
        
        % Stage 4
        c_hat = E2.*a_hat + Q.*(2*Nb_hat - Nu_hat);
        c = real(ifft(c_hat));
        Nc_hat = dealias_mask .* Laplacian_hat .* fft(c.^3 - mu*c);
        
        % Final Time Step Combination
        u_hat = E.*u_hat + f1.*Nu_hat + 2*f2.*(Na_hat + Nb_hat) + f3.*Nc_hat;
        u = real(ifft(u_hat));

        % Update data

        computed_density = zeros(1, num_time_steps);
        computed_density(1) = domainwall_density_computed(u, 2*Lx);
    
        theory_density = zeros(1, num_time_steps);
        theory_density(1) = domainwall_density_theory(t0,Laplacian_hat, u_hat);
        l2_hist(n) = l2_norm_periodic_1D(u_hat, 2*Lx);

        % Update figures
        if mod(n - 1, plot_every) == 0
            hLine1.YData = u;
            hTitle1.String = sprintf('t = %.3f, mu = %.3f', t(n), mu(t(n)));
            
            hLine2.XData = t(1:n);
            hLine2.YData = ls_hist(1:n);
            axis(ax2, 'tight');
            
            hLine3.YData = abs(u_hat);

 
            % 
            % subplot(1,3,2)
            % 
            % set(hline,...
            %     'XData',t_hist,...
            %     'YData',l2_hist)
            % 
            % axis tight
            % 
            % subplot(1,3,3)
            % 
            % blowup_mask = ...
            %     t_hist >= blowup_time;
            % 
            % set(theory_density_line,...
            %     'XData',t_hist(blowup_mask),...
            %     'YData',theory_density(blowup_mask))
            % 
            % set(comput_density_line,...
            %     'XData',t_hist(blowup_mask),...
            %     'YData',comput_density(blowup_mask))
            % 
            % axis tight
            
            drawnow limitrate % High performance render refresh
            
            if save_gif
                % Modern, clean single-line GIF output
                exportgraphics(fig, gif_filename, 'Append', true);
            end
        end
    end

    disp(['GIF saved to: ', gif_filename])

end


%% Seismic colormap
function cmap = seismic_colormap()

    n = 256;

    r = [(0:n/2-1)/(n/2), ones(1,n/2)];
    g = [(0:n/2-1)/(n/2), (n/2-1:-1:0)/(n/2)];
    b = [ones(1,n/2), (n/2-1:-1:0)/(n/2)];

    cmap = [r(:),g(:),b(:)];

end

%% L2 norm

function val = l2_norm_periodic_1D(u_hat,Lx)

    Nx = length(u_hat);

    val = sqrt(Lx) * ...
          sqrt(sum(abs(u_hat).^2))/Nx;

end