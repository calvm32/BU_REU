%% Initial Conditions and Set Up
%%%Coding Swift Hohenberg PDE in periodic domain NOT ON THE FLY!
clear all
close all


%if true, videos will be recorded
videos = false;


%spatial discretization
Nx = 2^8;
Ny = 2^13;
LNx = 30;
LNy = 2*120;
Lx = LNx*pi;
Ly = LNy*pi;
dx = 2*Lx/Nx;
dy = 2*Ly/Ny;
x = [-Lx:dx:Lx-dx];
y = [-Ly:dy:Ly-dy];


[X,Y] = meshgrid(x,y);


mu = 0.25;
k = 0.8;

dt = 0.1;
tf = 800;
t = [0:dt:tf];
Nt = length(t);


%spectral discretization
kx = [0:Nx/2 -Nx/2+1:-1]*(pi/Lx);       % wave numbers
ky = [0:Ny/2 -Ny/2+1:-1]*(pi/Ly);


[kkx,kky] = meshgrid(kx,ky);
k2 = (k^2 .* kkx.^2 + kky.^2); 

%Swift Hohenberg
L = -(1+2.*(-k2)+k2.^2) + mu;


%initial conditions
up = sqrt(4 / 3 * (mu - kappa^2)) * cos(k * x);

sigma = 0.1;
u0 = up + (rand(Ny, Nx) - 0.5) * sigma;


filename = sprintf('SH_mu=%.*f_k=%.*f', 1, mu, 1, k);%name file


%fix xh as a cross section of Y-u graph at the middle
xh = Nx/2;


%ETDRK4 setup 
E = exp(dt*L); 
E2 = exp(dt*L/2);
MM = 16; % no. of points for complex means
r = exp(1i*pi*((1:MM)-.5)/MM); % roots of unity
L = L(:);
LR = dt*L(:,ones(MM,1))+r(ones(Nx*Ny,1),:);
Q = dt*real(mean((exp(LR/2)-1)./LR ,2));
f1 = dt*real(mean((-4-LR+exp(LR).*(4-3*LR+LR.^2))./LR.^3 ,2));
f2 = dt*real(mean((2+LR+exp(LR).*(-2+LR))./LR.^3 ,2));
f3 = dt*real(mean((-4-3*LR-LR.^2+exp(LR).*(4-LR))./LR.^3 ,2));
f1=reshape(f1,Ny,Nx); f2=reshape(f2,Ny,Nx); f3=reshape(f3,Ny,Nx);
L=reshape(L,Ny,Nx); Q=reshape(Q,Ny,Nx); clear LR 


%create video
if videos == true
    v = VideoWriter(append(filename, '.mp4'),'MPEG-4');%name the video
    cross_sec = VideoWriter(append(filename, '_cut.mp4'),'MPEG-4');%name the video
    open(v);
    open(cross_sec);
end
%% time stepping with ETDRK4
%initialize some lists
ycross = [];
ucross = [];


%so figures don't pull you to that screen
fig1 = figure(1);
fig2 = figure(2);
fig3 = figure(3);
% fi3 = ;



%Take the initial condition into Fourier space
uh = fft2(u0);


for jj = 1:Nt
    u = real(ifft2(uh)); 
    Nu = fft2(-u.^3);
    a = E2.*uh + Q.*Nu;
    aa = real(ifft2(a));
    Na = fft2(mu.*aa-aa.^3);
    b = E2.*uh + Q.*Na;
    bb = real(ifft2(b));
    Nb = fft2(mu.*bb-bb.^3);
    ch = E2.*a + Q.*(2*Nb-Nu);
    cc = real(ifft2(ch));
    Nch = fft2(mu.*cc-cc.^3);
    uh = E.*uh + Nu.*f1 + 2*(Na+Nb).*f2 + Nch.*f3;
    
    %save cross section info for each time step
    ycross = y;%[ycross; Y(:,xh)'];
    ucross = [ucross; u(:,xh)'];


    %comment out this section for just a final image
    if mod(jj,10) ==0 %this determines how smooth/fast the video will be


        set(0,'CurrentFigure',fig1) %graph of system as it evolves
        surf(X,Y,real(u));
        colorbar;
        view([0 90]);
        shading interp;
        caxis([-1 1]);
        xlim([-0.9* Lx 0.9*Lx]);
        ylim([-Ly Ly]);
        title(['t = ' num2str(t(jj+1))]);
        xlabel('x');
        ylabel('y');
        drawnow


        %add video frames
        if videos == true
            frame = getframe(gcf);
            writeVideo(v,frame);
        end
        
        set(0,'CurrentFigure',fig2) %graph of cross section (u vs y)
        plot(Y(:,xh), real(u(:,xh)));
        title(['t = ' num2str(t(jj+1))]);
        xlim([-Ly Ly])
        ylim([-1 1]);
        xlabel('y');
        ylabel('u');
        %add video frames
        if videos == true
            frame = getframe(gcf);
            writeVideo(cross_sec,frame);
        end
    end
end


if videos == true
    close(v);
    close(cross_sec);
end


save(append(filename, '.mat'),'mu','k', 'kappa','Nx','Ny','Ly','Nt','dt','tf','ycross','ucross')
